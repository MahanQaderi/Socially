# Postgres connection string used by Prisma
DATABASE_URL="postgres://user:password@host:5432/database?sslmode=require"

# Secret used to sign auth sessions - generate one with: openssl rand -hex 32
BETTER_AUTH_SECRET="replace-me-with-a-random-32-byte-hex-string"

# Base url the auth server runs on
BETTER_AUTH_URL="http://localhost:3000"

# Where the frontend is served from - used for CORS and CSRF checks.
# Leave this unset for local development: it defaults to
# http://localhost:5173, which is the Vite dev server.
# FRONTEND_URL="http://localhost:5173"

# Uploadcare, used for profile pictures and post images
NEXT_PUBLIC_UPLOADCARE_API_KEY="your-uploadcare-public-key"
NEXT_PUBLIC_UPLOADCARE_CDN_CNAME="https://your-cdn-subdomain.ucarecd.net"
